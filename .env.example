# Vzor nastavení pro compose.yaml. Zkopírujte do .env a vyplňte.
# Soubor .env obsahuje hesla – nikdy ho necommitujte.

# Docker image aplikace (na serveru z GitHub Container Registry)
APP_IMAGE=ghcr.io/tgm126/lkkllog:latest
# Port na serveru, na který nginx předává požadavky
APP_PORT=8000

# Náhodný klíč: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=lety.lkkl.cz,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://lety.lkkl.cz

POSTGRES_DB=lkkllog
POSTGRES_USER=lkkllog
# Náhodné heslo, stejným způsobem jako DJANGO_SECRET_KEY
POSTGRES_PASSWORD=
