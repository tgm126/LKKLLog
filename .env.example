# Vzor nastavení pro compose.yaml (zkouška celé aplikace lokálně). Zkopírujte do .env.
# Na serveru se proměnné nastavují ve VPS Centru (viz docs/provoz.md).
# Soubor .env obsahuje hesla – nikdy ho necommitujte.

APP_IMAGE=lkkllog:local
APP_PORT=8000

# Náhodný klíč: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

POSTGRES_DB=lkkllog
POSTGRES_USER=lkkllog
# Náhodné heslo, stejným způsobem jako DJANGO_SECRET_KEY
POSTGRES_PASSWORD=
